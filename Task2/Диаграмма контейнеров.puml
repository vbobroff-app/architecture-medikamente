@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

left to right direction
title Диаграмма контейнеров To-Be: MVP «Медикаменте»

System_Boundary(system, "Медикаменте") {
    ' Портал для клиентов
    Container(patient_portal, "Портал пациентов", "React/Spring Boot", "PII, шифрование AES")
    
    ' Портал для сотрудников ресепшена
    Container(reception_portal, "Портал ресепшена", "Angular/Spring", "Управление записями, напоминания")
    
    ' CRM система
    Container(crm, "CRM", "Java/Postgres", "Управление пациентами, ABAC/RBAC")
    
    ' Платежная система
    Container(payment, "Платежный шлюз", "1C/API", "Обработка платежей PCI DSS")
    
    ' Интеграция с лабораторией
    Container(lab_api, "API лаборатории", "REST/OAuth2", "Защищенная интеграция анализов")
    
    ' BI/AI компоненты
    Container(bi_ml, "BI/ML-сервисы", "Python/Kubernetes", "Аналитика и предиктивные модели")
    
    ' Хранилища данных
    ContainerDb(db_patient, "БД пациентов", "PostgreSQL", "Шифрование PII, TDE")
    ContainerDb(data_lake, "Озеро данных", "ClickHouse+MinIO", "BI/ML-аналитика")
    ContainerDb(db_analytics, "Хранилище анализов", "ClickHouse", "Обезличенные PHI")
}

' Внутренние связи
Rel(patient_portal, reception_portal, "Синхронизация записей", "HTTPS", "JWT+RBAC, TSL 1.3")
Rel(reception_portal, crm, "Работа с клиентами", "RBAC", "TSL 1.3")
Rel(crm, db_patient, "Чтение/запись", "JDBC (TLS)")
Rel(patient_portal, payment, "Оплата услуг", "PCI DSS")
Rel(crm, lab_api, "Запрос анализов", "OAuth2")
Rel(lab_api, db_analytics, "Сохранение результатов", "HL7/FHIR")
Rel(data_lake, bi_ml, "Обучение моделей", "Airflow")
Rel(db_patient, data_lake, "Анонимизированные данные", "ETL")

' Внешние системы
System_Ext(lab, "Лаборатория", "Внешняя система")
System_Ext(bank, "Банк", "Платежная система")
System_Ext(mobile, "Мобильное приложение", "iOS/Android")

' Внешние связи
Rel(lab_api, lab, "Получение результатов", "HL7/FHIR")
Rel(payment, bank, "Проведение платежа", "PCI DSS")
Rel(patient_portal, mobile, "Синхронизация", "Push-уведомления")
@enduml